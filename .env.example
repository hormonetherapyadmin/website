# Copy to .env.local for local development. Never commit real values.

# "true" lets search engines index the site. Leave unset everywhere except
# the Netlify production context, and set it there only at cutover.
ALLOW_INDEXING=

# Shared secret configured on the Prismic webhook that calls /api/revalidate.
PRISMIC_WEBHOOK_SECRET=

# Permanent access token from Prismic Settings → API & Security.
# Leave unset while repository 1shr96di is public. Required once API access is private.
PRISMIC_ACCESS_TOKEN=

# Wix API key from Account Settings → API Keys. Shown once at creation.
# Read Blog (and Read Media if listed). This site only. Do not commit the value.
WIX_API_KEY=

# Site ID from the dashboard URL, the segment after /dashboard/.
WIX_SITE_ID=

# Account ID from the API Keys page (Copy ID). Blog export does not send
# this. Wix rejects it unless it is the account that owns the site.
WIX_ACCOUNT_ID=
