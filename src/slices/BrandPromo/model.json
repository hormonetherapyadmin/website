{
  "id": "brand_promo",
  "name": "Brand promo",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Default",
      "docURL": "",
      "id": "default",
      "imageUrl": "",
      "name": "Default",
      "primary": {
        "small_heading": {
          "config": {
            "allowTargetBlank": true,
            "label": "Small heading",
            "labels": ["superscript"],
            "placeholder": "Voted best for",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "heading": {
          "config": {
            "allowTargetBlank": true,
            "label": "Heading",
            "labels": ["superscript"],
            "placeholder": "Improved sleep",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "intro": {
          "config": {
            "allowTargetBlank": true,
            "label": "Intro",
            "labels": ["superscript"],
            "placeholder": "A short line under the clinic name. Leave blank to hide it.",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "link": {
          "config": {
            "allowTargetBlank": true,
            "allowText": true,
            "label": "Link"
          },
          "type": "Link"
        },
        "background": {
          "config": {
            "default_value": "Transparent",
            "label": "Background",
            "options": [
              "Transparent",
              "Cream",
              "Pink",
              "Blue",
              "Yellow",
              "Lavender",
              "Raspberry",
              "Navy"
            ]
          },
          "type": "Select"
        },
        "space_above": {
          "config": {
            "default_value": "Medium",
            "label": "Space above",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        },
        "space_below": {
          "config": {
            "default_value": "None",
            "label": "Space below",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        },
        "clinic": {
          "config": {
            "customtypes": [
              {
                "fields": [
                  "name",
                  "kind",
                  "logo",
                  "visit",
                  "page",
                  "youtube",
                  "product",
                  "monthly_price",
                  "price_unit",
                  "price_note",
                  "formulation",
                  "insurance",
                  "note",
                  "code",
                  "code_note",
                  "top_choice_label",
                  "quote"
                ],
                "id": "provider"
              }
            ],
            "label": "Clinic",
            "select": "document"
          },
          "type": "Link"
        },
        "quote": {
          "config": {
            "allowTargetBlank": true,
            "label": "Quote",
            "labels": ["superscript"],
            "placeholder": "Leave blank to use the clinic's In my words.",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "text": {
          "config": {
            "allowTargetBlank": true,
            "label": "Text",
            "labels": ["highlight", "superscript", "signoff", "note"],
            "multi": "heading2,heading3,heading4,paragraph,strong,em,hyperlink,list-item,o-list-item,image,embed",
            "placeholder": "More about this brand, such as what a test kit measures. Leave blank to hide it."
          },
          "type": "StructuredText"
        },
        "first": {
          "config": {
            "default_value": false,
            "label": "Is this 1st?",
            "placeholder_false": "No",
            "placeholder_true": "Yes"
          },
          "type": "Boolean"
        },
        "place": {
          "config": {
            "label": "Place",
            "placeholder": "My 2026 top choice. Shown beside the 1st badge."
          },
          "type": "Text"
        },
        "product": {
          "config": {
            "label": "Product image",
            "placeholder": "Empty uses the brand's product image. Describe the product."
          },
          "type": "Image"
        },
        "layout": {
          "config": {
            "default_value": "Beside",
            "label": "Photo and price",
            "options": ["Beside", "Stacked"],
            "placeholder": "Beside puts the price next to the photo. Stacked puts the photo on top and the price under it, as one card. Use Stacked when the card has a lot of writing."
          },
          "type": "Select"
        },
        "links": {
          "config": {
            "allowTargetBlank": true,
            "allowText": true,
            "label": "Links",
            "placeholder": "Extra links under the buttons, such as My review or a comparison.",
            "repeat": true
          },
          "type": "Link"
        }
      },
      "version": ""
    }
  ]
}
