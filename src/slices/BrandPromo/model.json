{
  "id": "brand_promo",
  "name": "Brand promo",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Default",
      "docURL": "",
      "id": "default",
      "imageUrl": "https://images.prismic.io/1shr96di/shared-slices/brand_promo/default/b107c2797775101ae99aa3576dce81c4d2fc8749.png?auto=compress%2Cformat",
      "name": "Default",
      "primary": {
        "heading": {
          "config": {
            "allowTargetBlank": true,
            "label": "Heading (H2)",
            "labels": ["superscript"],
            "placeholder": "Improved sleep",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "clinic": {
          "config": {
            "customtypes": [
              {
                "fields": [
                  "name",
                  "kind",
                  "logo",
                  "visit",
                  "page",
                  "review",
                  "comparison",
                  "youtube",
                  "product",
                  "monthly_price",
                  "price_unit",
                  "price_note",
                  "formulation",
                  "insurance",
                  "note",
                  "code",
                  "code_note",
                  "top_choice_label",
                  "quote"
                ],
                "id": "provider"
              }
            ],
            "label": "Clinic",
            "select": "document"
          },
          "type": "Link"
        },
        "first": {
          "config": {
            "default_value": false,
            "label": "Is this 1st?",
            "placeholder_false": "No",
            "placeholder_true": "Yes"
          },
          "type": "Boolean"
        },
        "place": {
          "config": {
            "label": "Place",
            "placeholder": "My 2026 top choice. Shown beside the 1st badge."
          },
          "type": "Text"
        },
        "overwrite": {
          "config": {
            "fields": {
              "small_heading": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Eyebrow",
                  "labels": ["superscript"],
                  "placeholder": "Voted best for",
                  "single": "paragraph,strong,em,hyperlink"
                },
                "type": "StructuredText"
              },
              "intro": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Line under the name",
                  "labels": ["superscript"],
                  "placeholder": "A short line under the clinic name. Leave blank to hide it.",
                  "single": "paragraph,strong,em,hyperlink"
                },
                "type": "StructuredText"
              },
              "quote": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Quote",
                  "labels": ["superscript"],
                  "placeholder": "Leave blank to use the clinic's In my words.",
                  "single": "paragraph,strong,em,hyperlink"
                },
                "type": "StructuredText"
              },
              "text": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Text under the quote",
                  "labels": ["highlight", "superscript", "signoff", "note"],
                  "multi": "heading2,heading3,heading4,paragraph,strong,em,hyperlink,list-item,o-list-item,image,embed",
                  "placeholder": "More about this brand, such as what a test kit measures. Leave blank to hide it."
                },
                "type": "StructuredText"
              },
              "product": {
                "config": {
                  "label": "Product image",
                  "placeholder": "Empty uses the brand's product image. Describe the product."
                },
                "type": "Image"
              },
              "style": {
                "config": {
                  "default_value": "Card",
                  "label": "Style",
                  "options": ["Quote", "Card"],
                  "placeholder": "Quote puts the logo, her words, and a visit link on the right. Card puts the product photo and price there."
                },
                "type": "Select"
              },
              "layout": {
                "config": {
                  "default_value": "Beside",
                  "label": "Photo and price",
                  "options": ["Beside", "Stacked"],
                  "placeholder": "Beside puts the price next to the photo. Stacked puts the photo on top and the price under it, as one card. Use Stacked when the card has a lot of writing."
                },
                "type": "Select"
              },
              "links": {
                "config": {
                  "allowTargetBlank": true,
                  "allowText": true,
                  "label": "Links",
                  "placeholder": "A comparison or another link. Shown under the buttons.",
                  "repeat": true
                },
                "type": "Link"
              }
            },
            "label": "Overwrite",
            "repeat": false
          },
          "type": "Group"
        },
        "card_position": {
          "config": {
            "default_value": "Center",
            "label": "Card position",
            "options": ["Center", "Top", "Sticky"],
            "placeholder": "Center lines the card up with the middle of the writing. Top lines it up with the first line. Sticky keeps it in view while long writing scrolls."
          },
          "type": "Select"
        },
        "background": {
          "config": {
            "default_value": "Transparent",
            "label": "Background",
            "options": [
              "Transparent",
              "Cream",
              "Pink",
              "Blue",
              "Yellow",
              "Lavender",
              "Raspberry",
              "Navy"
            ]
          },
          "type": "Select"
        },
        "space_above": {
          "config": {
            "default_value": "Medium",
            "label": "Space above",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        },
        "space_below": {
          "config": {
            "default_value": "None",
            "label": "Space below",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        }
      },
      "version": ""
    }
  ]
}
