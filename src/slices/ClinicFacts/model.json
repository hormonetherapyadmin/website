{
  "id": "clinic_facts",
  "name": "Clinic facts",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Default",
      "docURL": "",
      "id": "default",
      "imageUrl": "",
      "name": "Default",
      "primary": {
        "small_heading": {
          "config": {
            "allowTargetBlank": true,
            "label": "Eyebrow",
            "labels": ["superscript"],
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "heading": {
          "config": {
            "allowTargetBlank": true,
            "label": "Heading (H2)",
            "labels": ["superscript"],
            "placeholder": "The facts",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "intro": {
          "config": {
            "allowTargetBlank": true,
            "label": "Content",
            "labels": ["superscript"],
            "placeholder": "What I confirmed on their page. This is my experience as a patient, not a medical review.",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "clinic": {
          "config": {
            "customtypes": [
              {
                "fields": [
                  "name",
                  "kind",
                  "logo",
                  "short_description",
                  "visit",
                  "code",
                  "code_note",
                  "state_availability",
                  "formulation",
                  "lab_requirement",
                  "insurance",
                  "hsa_fsa",
                  "note",
                  "specialties",
                  {
                    "fields": ["title", "text"],
                    "id": "how_it_works"
                  }
                ],
                "id": "provider"
              }
            ],
            "label": "Clinic",
            "select": "document"
          },
          "type": "Link"
        },
        "image": {
          "config": {
            "label": "Image",
            "placeholder": "Describe what is in the photo."
          },
          "type": "Image"
        },
        "background": {
          "config": {
            "default_value": "Transparent",
            "label": "Background",
            "options": [
              "Transparent",
              "Cream",
              "Pink",
              "Blue",
              "Yellow",
              "Lavender",
              "Raspberry",
              "Navy"
            ]
          },
          "type": "Select"
        },
        "space_above": {
          "config": {
            "default_value": "Medium",
            "label": "Space above",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        },
        "space_below": {
          "config": {
            "default_value": "None",
            "label": "Space below",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        }
      },
      "version": ""
    }
  ]
}
