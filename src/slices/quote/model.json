          "type": "Select"
        },
        "space_below": {
          "config": {
            "default_value": "None",
            "label": "Space below",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        },
        "quote": {
          "config": {
            "allowTargetBlank": true,
            "label": "Quote",
            "labels": ["superscript"],
