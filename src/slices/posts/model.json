    {
      "description": "Five posts. The newest is the large card. Category limits the list.",
      "docURL": "",
      "id": "home",
      "imageUrl": "",
      "items": {},
      "name": "Homepage",
      "primary": {
        "section": {
          "config": {
            "fields": {
              "small_heading": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Small heading",
                  "single": "paragraph,strong,em,hyperlink"
                },
                "type": "StructuredText"
              },
              "heading": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Heading",
                  "placeholder": "Latest reviews and posts",
                  "single": "paragraph,strong,em,hyperlink"
                },
                "type": "StructuredText"
              },
              "intro": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Intro",
                  "single": "paragraph,strong,em,hyperlink"
                },
                "type": "StructuredText"
              },
              "link": {
                "config": {
                  "allowTargetBlank": true,
                  "allowText": true,
                  "label": "Link"
                },
                "type": "Link"
              },
              "background": {
                "config": {
                  "default_value": "Same as the page",
                  "label": "Background",
                  "options": ["Same as the page", "Soft", "Highlight", "Dark"]
                },
                "type": "Select"
              },
              "space_above": {
                "config": {
                  "default_value": "Medium",
                  "label": "Space above",
                  "options": ["None", "Small", "Medium", "Large"]
                },
                "type": "Select"
              },
              "space_below": {
                "config": {
                  "default_value": "None",
                  "label": "Space below",
                  "options": ["None", "Small", "Medium", "Large"]
                },
                "type": "Select"
              }
            },
            "label": "Section",
            "repeat": false
          },
          "type": "Group"
        },
        "category": {
          "config": {
            "default_value": "All",
            "label": "Category",
            "options": [
              "All",
              "Review",
              "Comparison",
              "My experience",
              "HRT 101"
            ]
          },
          "type": "Select"
        }
      },
