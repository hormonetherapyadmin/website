  "variations": [
    {
      "description": "A photo beside the writing. The homepage story uses this.",
      "docURL": "",
      "id": "image",
      "imageUrl": "",
      "items": {},
      "name": "Image",
      "primary": {
        "small_heading": {
          "config": {
            "allowTargetBlank": true,
            "label": "Eyebrow",
            "labels": ["superscript"],
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "heading": {
          "config": {
            "allowTargetBlank": true,
            "label": "Heading (H2)",
            "labels": ["superscript"],
            "placeholder": "Menopause isn't a dirty word.",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "text": {
          "config": {
            "allowTargetBlank": true,
            "label": "Content",
            "labels": ["highlight", "superscript", "signoff", "note"],
