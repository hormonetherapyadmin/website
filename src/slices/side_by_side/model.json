            "placeholder": "Signoff on a whole paragraph is the large closing line. Note on a whole paragraph is the tint box. Start a paragraph with {{provider:inner-balance:offer}} or {{provider:inner-balance:facts}} to pull that clinic in."
          },
          "type": "StructuredText"
        },
        "quote": {
          "config": {
            "label": "Quote",
            "labels": ["superscript"],
            "placeholder": "A large sentence at the top of the writing side. Leave blank to hide it.",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "button": {
          "config": {
            "allowTargetBlank": true,
            "allowText": true,
            "label": "Buttons",
            "placeholder": "Read my whole story",
            "repeat": true,
            "variants": ["Solid", "Ghost"]
          },
          "type": "Link"
        },
        "image": {
          "config": {
            "constraint": {},
            "label": "Image",
            "thumbnails": []
          },
          "type": "Image"
        },
        "image_link": {
          "config": {
            "allowTargetBlank": true,
            "label": "Photo link"
          },
          "type": "Link"
        },
        "caption": {
          "config": {
            "label": "Caption",
            "labels": ["superscript"],
            "placeholder": "The line about this photo. Me and Winston, my Bernedoodle.",
            "single": "paragraph,strong,em,hyperlink"
          },
          "type": "StructuredText"
        },
        "caption_on_photo": {
          "config": {
            "default_value": true,
            "label": "Caption on the photo",
            "placeholder_false": "Under the photo",
            "placeholder_true": "On the photo"
          },
          "type": "Boolean"
        },
        "side": {
          "config": {
            "default_value": "Media left",
            "label": "Side",
            "options": ["Media left", "Media right"],
            "placeholder": "Media left puts the photo on the left."
          },
          "type": "Select"
        },
        "media_position": {
          "config": {
            "default_value": "Center",
            "label": "Media position",
            "options": ["Center", "Top", "Sticky"],
            "placeholder": "Center lines the media up with the middle of the writing. Top lines it up with the first line. Sticky keeps it in view while long writing scrolls."
          },
          "type": "Select"
        },
        "background": {
          "config": {
            "default_value": "Transparent",
            "label": "Background",
            "options": [
              "Transparent",
              "Cream",
              "Pink",
              "Blue",
              "Yellow",
              "Lavender",
              "Raspberry",
              "Navy"
            ]
          },
          "type": "Select"
        },
        "space_above": {
          "config": {
            "default_value": "Medium",
            "label": "Space above",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        },
        "space_below": {
          "config": {
            "default_value": "None",
            "label": "Space below",
            "options": ["None", "Small", "Medium", "Large"]
          },
          "type": "Select"
        }
