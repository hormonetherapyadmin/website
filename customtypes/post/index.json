{
  "format": "page",
  "id": "post",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID",
          "placeholder": "URL for page"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "allowTargetBlank": true,
          "label": "Title",
          "labels": ["superscript"],
          "placeholder": "",
          "single": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      },
      "sub_title": {
        "config": {
          "allowTargetBlank": true,
          "label": "Subtitle",
          "labels": ["superscript"],
          "placeholder": "The line under the title, and the card.",
          "single": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      },
      "image": {
        "config": {
          "constraint": {},
          "label": "Image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "caption": {
        "config": {
          "allowTargetBlank": true,
          "label": "Image caption",
          "labels": ["superscript"],
          "placeholder": "The line under the photo. It can include a link.",
          "single": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      },
      "note": {
        "config": {
          "allowTargetBlank": true,
          "label": "Personal note",
          "labels": ["superscript"],
          "placeholder": "The box above the story. The label Personal review note is added for you.",
          "single": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      },
      "body": {
        "config": {
          "allowTargetBlank": true,
          "label": "Story",
          "labels": ["highlight", "superscript"],
          "multi": "heading2,heading3,heading4,paragraph,strong,em,hyperlink,list-item,o-list-item,image,embed",
          "placeholder": "Write the story readers will see. A line that is only {{table}} shows the Table field there."
        },
        "type": "StructuredText"
      },
      "table": {
        "config": {
          "label": "Table"
        },
        "type": "Table"
      },
      "author": {
        "config": {
          "customtypes": [
            {
              "fields": ["name", "about", "profile"],
              "id": "author"
            }
          ],
          "label": "Author",
          "placeholder": "Leave empty for Peggy.",
          "repeat": false,
          "select": "document"
        },
        "type": "Link"
      },
      "published_date": {
        "config": {
          "label": "Published",
          "placeholder": ""
        },
        "type": "Date"
      },
      "category": {
        "config": {
          "label": "Category",
          "options": ["Review", "Comparison", "My experience", "HRT 101"],
          "placeholder": "Shown above the title. Leave blank if none of these fit."
        },
        "type": "Select"
      },
      "sources": {
        "config": {
          "fields": {
            "link": {
              "config": {
                "allowTargetBlank": true,
                "allowText": true,
                "label": "Link",
                "repeat": false,
                "select": null
              },
              "type": "Link"
            },
            "detail": {
              "config": {
                "label": "Detail",
                "placeholder": "PubMed Central"
              },
              "type": "Text"
            }
          },
          "label": "Sources",
          "repeat": true
        },
        "type": "Group"
      }
    },
    "SEO": {
      "meta_title": {
        "config": {
          "label": "Meta title",
          "placeholder": "Leave empty to use the post title."
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta description",
          "placeholder": "Leave empty to use the subtitle."
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {},
          "label": "Social image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "canonical": {
        "config": {
          "allowTargetBlank": false,
          "allowText": false,
          "label": "Canonical",
          "placeholder": "Leave empty unless this post should point at a different address.",
          "repeat": false,
          "select": null
        },
        "type": "Link"
      },
      "indexing": {
        "config": {
          "default_value": true,
          "label": "Indexing",
          "placeholder_false": "No index",
          "placeholder_true": "Index"
        },
        "type": "Boolean"
      }
    }
  },
  "label": "Blog post",
  "repeatable": true,
  "status": true
}
