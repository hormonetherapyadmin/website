{
  "format": "page",
  "id": "article",
  "label": "Blog post",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": "Wix slug, unchanged"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "",
          "allowTargetBlank": true,
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "url_section": {
        "type": "Select",
        "config": {
          "label": "URL section",
          "placeholder": "",
          "options": ["Blog post (/post/…)", "Site page (/…)"],
          "default_value": "Blog post (/post/…)"
        }
      },
      "excerpt": {
        "type": "StructuredText",
        "config": {
          "label": "Excerpt",
          "placeholder": "The card and the feed. One or two sentences.",
          "allowTargetBlank": true,
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "dek": {
        "type": "StructuredText",
        "config": {
          "label": "Dek",
          "placeholder": "The line under the title. Leave empty if you have none.",
          "allowTargetBlank": true,
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "image": {
        "type": "Image",
        "config": {
          "label": "Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "caption": {
        "type": "StructuredText",
        "config": {
          "label": "Caption",
          "placeholder": "The line under the photo. It can include a link.",
          "allowTargetBlank": true,
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "author": {
        "type": "Link",
        "config": {
          "label": "Author",
          "select": "document",
          "customtypes": ["author"],
          "repeat": false
        }
      },
      "published_date": {
        "type": "Date",
        "config": {
          "label": "Published",
          "placeholder": ""
        }
      },
      "updated_date": {
        "type": "Date",
        "config": {
          "label": "Updated",
          "placeholder": "Change this when you revise the story."
        }
      },
      "read_time": {
        "type": "Number",
        "config": {
          "label": "Minutes to read",
          "placeholder": "Change this if the story gets much longer or shorter."
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Category",
          "placeholder": "Shown above the title. Leave blank if none of these fit.",
          "options": ["Review", "Comparison", "My experience", "HRT 101"]
        }
      },
      "note": {
        "type": "StructuredText",
        "config": {
          "label": "Personal note",
          "placeholder": "The box above the story. The label Personal review note is added for you.",
          "allowTargetBlank": true,
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "body": {
        "type": "StructuredText",
        "config": {
          "label": "Story",
          "placeholder": "To add a clinic's offer, start a paragraph with {{provider:inner-balance:offer}} and use that clinic's id. Write your sentence after it. {{provider:inner-balance:facts}} adds that clinic's price and formulation.",
          "allowTargetBlank": true,
          "multi": "heading2,heading3,heading4,paragraph,strong,em,hyperlink,list-item,o-list-item,image,embed",
          "labels": ["highlight", "superscript"]
        }
      },
      "sources": {
        "type": "Group",
        "config": {
          "label": "Sources",
          "repeat": true,
          "fields": {
            "link": {
              "type": "Link",
              "config": {
                "label": "Link",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            },
            "detail": {
              "type": "Text",
              "config": {
                "label": "Detail",
                "placeholder": "PubMed Central"
              }
            }
          }
        }
      },
      "tags": {
        "type": "Group",
        "config": {
          "label": "Tags",
          "repeat": true,
          "fields": {
            "name": {
              "type": "Text",
              "config": {
                "label": "Tag",
                "placeholder": "A Wix tag, kept as a label"
              }
            }
          }
        }
      },
      "topics": {
        "type": "Group",
        "config": {
          "label": "Topics",
          "repeat": true,
          "fields": {
            "topic": {
              "type": "Link",
              "config": {
                "label": "Topic",
                "select": "document",
                "customtypes": ["topic"],
                "repeat": false
              }
            }
          }
        }
      },
      "treatments": {
        "type": "Group",
        "config": {
          "label": "Treatments",
          "repeat": true,
          "fields": {
            "treatment": {
              "type": "Link",
              "config": {
                "label": "Treatment",
                "select": "document",
                "customtypes": ["treatment"],
                "repeat": false
              }
            }
          }
        }
      },
      "clinics": {
        "type": "Group",
        "config": {
          "label": "Clinics",
          "repeat": true,
          "fields": {
            "clinic": {
              "type": "Link",
              "config": {
                "label": "Clinic",
                "select": "document",
                "customtypes": ["provider"],
                "repeat": false
              }
            }
          }
        }
      },
      "related": {
        "type": "Group",
        "config": {
          "label": "Related posts",
          "repeat": true,
          "fields": {
            "post": {
              "type": "Link",
              "config": {
                "label": "Post",
                "select": "document",
                "customtypes": ["article", "provider_review", "comparison"],
                "repeat": false
              }
            }
          }
        }
      }
    },
    "SEO": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta title",
          "placeholder": "Leave empty to use the post title."
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta description",
          "placeholder": "Leave empty to use the excerpt."
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Social image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "canonical": {
        "type": "Link",
        "config": {
          "label": "Canonical",
          "placeholder": "Leave empty unless this post should point at a different address.",
          "select": null,
          "allowTargetBlank": false,
          "allowText": false,
          "repeat": false
        }
      },
      "indexing": {
        "type": "Select",
        "config": {
          "label": "Indexing",
          "placeholder": "",
          "options": ["Index", "No index"],
          "default_value": "Index"
        }
      }
    }
  }
}
