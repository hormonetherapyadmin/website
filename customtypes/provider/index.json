{
  "format": "custom",
  "id": "provider",
  "json": {
    "Profile": {
      "uid": {
        "config": {
          "label": "UID",
          "placeholder": "inner-balance"
        },
        "type": "UID"
      },
      "name": {
        "config": {
          "label": "Name",
          "placeholder": ""
        },
        "type": "Text"
      },
      "logo": {
        "config": {
          "constraint": {},
          "label": "Logo",
          "thumbnails": []
        },
        "type": "Image"
      },
      "short_description": {
        "config": {
          "label": "Short description",
          "placeholder": "Better sleep. The comparison chart and other clinic summaries use this."
        },
        "type": "Text"
      },
      "visit": {
        "config": {
          "allowTargetBlank": true,
          "allowText": true,
          "label": "Visit",
          "placeholder": "The affiliate link. Opens in a new tab.",
          "repeat": false,
          "select": null
        },
        "type": "Link"
      },
      "top_choice_label": {
        "config": {
          "label": "Top choice label",
          "placeholder": "Leave blank for no badge."
        },
        "type": "Text"
      }
    },
    "Price": {
      "monthly_price": {
        "config": {
          "label": "Monthly price",
          "placeholder": "What I paid per month. The comparison chart uses this."
        },
        "type": "Number"
      },
      "price_note": {
        "config": {
          "label": "Price note",
          "placeholder": "The line under the chart price."
        },
        "type": "Text"
      },
      "display_price": {
        "config": {
          "label": "Display price",
          "placeholder": "The price on the clinic page, such as 199."
        },
        "type": "Text"
      },
      "display_price_note": {
        "config": {
          "label": "Display price note",
          "placeholder": "First six months, then $99."
        },
        "type": "Text"
      }
    },
    "Care": {
      "formulation": {
        "config": {
          "label": "Typically prescribed",
          "placeholder": "Oestra vaginal cream. The chart and the price card use this."
        },
        "type": "Text"
      },
      "lab_requirement": {
        "config": {
          "label": "Labs",
          "placeholder": "None, or $150 labs up front."
        },
        "type": "Text"
      },
      "insurance": {
        "config": {
          "default_value": false,
          "label": "Takes insurance",
          "placeholder_false": "No",
          "placeholder_true": "Yes"
        },
        "type": "Boolean"
      },
      "hsa_fsa": {
        "config": {
          "label": "HSA / FSA",
          "placeholder": "Yes, or No"
        },
        "type": "Text"
      },
      "state_availability": {
        "config": {
          "label": "State availability",
          "placeholder": "All 50 states"
        },
        "type": "Text"
      },
      "note": {
        "config": {
          "label": "Getting started",
          "placeholder": "No visit. Shown under the quote and on the clinic facts."
        },
        "type": "Text"
      }
    },
    "Words": {
      "quote": {
        "config": {
          "allowTargetBlank": true,
          "label": "In my words",
          "labels": ["superscript"],
          "placeholder": "",
          "single": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      }
    },
    "Offer": {
      "offer": {
        "config": {
          "customtypes": ["offer"],
          "label": "Offer",
          "repeat": false,
          "select": "document"
        },
        "type": "Link"
      }
    },
    "Links": {
      "review": {
        "config": {
          "customtypes": ["provider_review"],
          "label": "Review",
          "repeat": false,
          "select": "document"
        },
        "type": "Link"
      }
    }
  },
  "label": "Clinic",
  "repeatable": true,
  "status": true
}
