{
  "format": "custom",
  "id": "provider",
  "json": {
    "Profile": {
      "uid": {
        "config": {
          "label": "UID",
          "placeholder": "inner-balance"
        },
        "type": "UID"
      },
      "name": {
        "config": {
          "label": "Name",
          "placeholder": ""
        },
        "type": "Text"
      },
      "logo": {
        "config": {
          "constraint": {},
          "label": "Logo",
          "thumbnails": []
        },
        "type": "Image"
      },
      "short_description": {
        "config": {
          "label": "Short description",
          "placeholder": "Better sleep. The comparison chart and other clinic summaries use this."
        },
        "type": "Text"
      },
      "visit": {
        "config": {
          "allowTargetBlank": true,
          "allowText": true,
          "label": "Visit",
          "placeholder": "The affiliate link. Opens in a new tab.",
          "repeat": false,
          "select": null
        },
        "type": "Link"
      },
      "top_choice_label": {
        "config": {
          "label": "Top choice label",
          "placeholder": "Leave blank for no badge."
        },
        "type": "Text"
      }
    },
    "Price": {
      "monthly_price": {
        "config": {
          "label": "Price",
          "placeholder": "What I paid per month. The chart and the clinic page use this."
        },
        "type": "Number"
      },
      "price_note": {
        "config": {
          "label": "Price note",
          "placeholder": "The line under the price, such as First six months, then $99."
        },
        "type": "Text"
      },
      "formulation": {
        "config": {
          "label": "Typically prescribed",
          "placeholder": "First bullet in the price box. Oestra vaginal cream."
        },
        "type": "Text"
      },
      "insurance": {
        "config": {
          "default_value": false,
          "label": "Takes insurance",
          "placeholder_false": "No",
          "placeholder_true": "Yes"
        },
        "type": "Boolean"
      },
      "note": {
        "config": {
          "label": "Getting started",
          "placeholder": "Third bullet in the price box. No visit."
        },
        "type": "Text"
      },
      "code": {
        "config": {
          "label": "Code",
          "placeholder": "PEGGY10. Leave blank when there is no code."
        },
        "type": "Text"
      },
      "code_note": {
        "config": {
          "label": "Code line",
          "placeholder": "10% off your first order."
        },
        "type": "Text"
      }
    },
    "Care": {
      "lab_requirement": {
        "config": {
          "label": "Labs",
          "placeholder": "None, or $150 labs up front."
        },
        "type": "Text"
      },
      "hsa_fsa": {
        "config": {
          "default_value": false,
          "label": "HSA / FSA",
          "placeholder_false": "No",
          "placeholder_true": "Yes"
        },
        "type": "Boolean"
      },
      "state_availability": {
        "config": {
          "label": "State availability",
          "placeholder": "All 50 states"
        },
        "type": "Text"
      }
    },
    "Words": {
      "quote": {
        "config": {
          "allowTargetBlank": true,
          "label": "In my words",
          "labels": ["superscript"],
          "placeholder": "",
          "single": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      }
    }
  },
  "label": "Clinic",
  "repeatable": true,
  "status": true
}
